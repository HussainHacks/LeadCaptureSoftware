# ==============================================================================
# HVAC Lead Conversion Platform - Environment Configuration Template
# ==============================================================================
# Duplicate this file to .env and adjust values for your local environment.
# Never commit .env with real credentials into source control.

# Application General Settings
PROJECT_NAME="HVAC Lead Conversion Platform"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="replace-with-a-secure-random-secret-key-min-32-chars"
API_V1_PREFIX="/api"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=leadgen
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@localhost:5432/leadgen
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres_dev_password@localhost:5432/leadgen

# Redis Configuration (Cache & Event Queue)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# n8n Automation Engine
N8N_PORT=5678
N8N_HOST="localhost"
N8N_PROTOCOL="http"
N8N_POSTGRES_DB="n8n"
N8N_ENCRYPTION_KEY="replace-with-secure-32-char-encryption-key"
N8N_WEBHOOK_URL="http://localhost:5678/"

# AI Service Configuration
# Provider options: openai, simulated
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-your-openai-api-key-here"
AI_MODEL_NAME="gpt-4o-mini"
AI_QUALIFICATION_TIMEOUT_SECONDS=15

# Messaging & SMS Provider (Twilio / Simulated)
# Mode: simulated (default for local dev) or twilio
MESSAGING_MODE="simulated"
TWILIO_ACCOUNT_SID="AC_mock_twilio_account_sid"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15550001234"

# Calendar & Scheduling Provider
# Mode: simulated (default for local dev) or google_calendar
CALENDAR_MODE="simulated"

# Internal Service Communication
INTERNAL_API_KEY="replace-with-secure-internal-service-token"

# Demo Mode (WARNING: Keep DEMO_ENABLED=false in production! Never enable in production.)
DEMO_ENABLED=false
DEMO_PASSWORD=""

# Logging & Monitoring
LOG_LEVEL="INFO"
